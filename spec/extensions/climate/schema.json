{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgiar-climate-data-hub.github.io/cdh-metadata-standard/v0.1.0/extensions/climate/schema.json",
  "title": "Climate Extension",
  "description": "Climate projection provenance: baseline, bias adjustment, downscaling, scenarios.",
  "type": "object",
  "$defs": {
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "numberOrString": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "date": {
      "description": "Date or date-time. Use YYYY-MM-DD (e.g. 2026-06-23) or an RFC 3339 date-time (e.g. 2026-06-23T00:00:00Z).",
      "examples": ["2026-06-23", "2026-06-23T00:00:00Z"],
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date-time",
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "climate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "description": "Reference/baseline period the projections are expressed against.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_date": {
              "$ref": "#/$defs/date"
            },
            "end_date": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "bias_adjustment": {
          "description": "Bias adjustment applied to the projections.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "Bias-adjustment method."
            },
            "reference_dataset": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "Reference dataset used for bias adjustment."
            }
          }
        },
        "downscaling": {
          "description": "Downscaling applied to the projections.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "$ref": "#/$defs/nonEmptyString",
              "description": "Downscaling method."
            },
            "resolution": {
              "$ref": "#/$defs/numberOrString",
              "description": "Target resolution of the downscaling."
            }
          }
        },
        "mip_era": {
          "description": "CMIP era of the source models.",
          "enum": ["CMIP5", "CMIP6"]
        },
        "models": {
          "description": "Climate model source IDs; use 'ensemble' for a multi-model ensemble.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenarios": {
          "description": "Scenario labels, e.g. SSP/RCP or historic.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
