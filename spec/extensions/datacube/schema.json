{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgiar-climate-data-hub.github.io/cdh-metadata-standard/v0.1.0/extensions/datacube/schema.json",
  "title": "Datacube Extension",
  "description": "Dimensions and variables for gridded, multidimensional, or tabular data.",
  "type": "object",
  "$defs": {
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "scalar": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    }
  },
  "properties": {
    "dimensions": {
      "description": "Cube axes, e.g. lat, lon, time, or a domain axis like crop.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "not": { "const": "variable" },
            "description": "Axis name. Must not be \"variable\": measures are not axes and belong in variables[]; href_template refers to them via the reserved {variable} token."
          },
          "description": {
            "type": "string",
            "description": "What the dimension is; define coded values here, or via reference_system or a sidecar.",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Dimension type: spatial, temporal, bands, or a domain axis (e.g. crop, scenario).",
            "minLength": 1
          },
          "reference_system": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Controlled-vocabulary URI or label defining the dimension's values, when coded."
          },
          "values": {
            "description": "Allowed values along the dimension.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      }
    },
    "variables": {
      "description": "Measurement variables, bands, or columns.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Stable definition and reading guidance for the variable.",
            "minLength": 1
          },
          "data_type": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Data type, numpy-style (e.g. float32, int16)."
          },
          "dimensions": {
            "description": "Axes this variable spans; omit when it spans all declared dimensions.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unit": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Unit of measurement, preferably compliant with UDUNITS-2 or UCUM.",
            "examples": ["t ha-1", "{head}/km2"]
          },
          "note": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Variable-specific caveats, limitations, or warnings."
          }
        }
      }
    }
  }
}
