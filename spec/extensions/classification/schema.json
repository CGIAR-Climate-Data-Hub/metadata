{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgiar-climate-data-hub.github.io/cdh-metadata-standard/v0.3.0/extensions/classification/schema.json",
  "title": "Classification Extension",
  "description": "Class definitions for categorical / classified variables.",
  "type": "object",
  "properties": {
    "classes": {
      "description": "Class definitions for categorical variables; each entry maps to a variable.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variable": {
            "type": "string",
            "description": "Name of the variable these classes apply to.",
            "minLength": 1
          },
          "values": {
            "description": "The class values for the variable.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Human-readable class label.",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "description": "What this class means.",
                  "minLength": 1
                },
                "value": {
                  "description": "The coded value as stored in the data.",
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
